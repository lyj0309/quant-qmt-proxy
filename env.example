# Runtime environment variables

# App
APP_MODE=mock
APP_SERVERS=all
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000

# gRPC
GRPC_HOST=0.0.0.0
GRPC_PORT=50051

# Authentication
APP_API_KEYS=mock-api-key-001,mock-api-key-002

# xtquant / QMT
QMT_USERDATA_PATH=D:\QMT\userdata_mini
# Wine may filter variables ending in PATH, so the Docker launcher also sets this alias.
QMT_USERDATA_DIR=D:\QMT\userdata_mini
QMT_XTDC_HOST=127.0.0.1
QMT_XTDC_PORT=58610
APP_ENABLE_PROD_ORDERS=false
